  "fixed_sql": [
    {
      "name": "progress_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"progress_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"lesson_id\" TEXT NOT NULL UNIQUE, \"is_completed\" INTEGER NOT NULL CHECK (\"is_completed\" IN (0, 1)), \"xp_earned\" INTEGER NOT NULL, \"completed_at\" INTEGER NOT NULL, \"full_xp_awarded\" INTEGER NOT NULL DEFAULT 1 CHECK (\"full_xp_awarded\" IN (0, 1)), \"correct_count\" INTEGER NOT NULL DEFAULT 0, \"graded_total\" INTEGER NOT NULL DEFAULT 0, \"last_practice_xp_date\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "card_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"card_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"card_id\" TEXT NOT NULL UNIQUE, \"unlocked_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "user_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_settings\" (\"id\" INTEGER NOT NULL, \"haptics_enabled\" INTEGER NOT NULL CHECK (\"haptics_enabled\" IN (0, 1)), \"sound_enabled\" INTEGER NOT NULL CHECK (\"sound_enabled\" IN (0, 1)), \"total_xp\" INTEGER NOT NULL, \"onboarding_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_completed\" IN (0, 1)), \"onboarding_goal\" TEXT NULL, \"onboarding_brewer\" TEXT NULL, \"theme_mode\" TEXT NOT NULL DEFAULT 'dark', \"tour_seen\" INTEGER NOT NULL DEFAULT 0 CHECK (\"tour_seen\" IN (0, 1)), \"tips_seen\" TEXT NOT NULL DEFAULT '', \"learner_name\" TEXT NULL, \"notifications_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"notifications_enabled\" IN (0, 1)), \"daily_reminder_time\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "module_progress_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"module_progress_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"module_id\" TEXT NOT NULL UNIQUE, \"module_xp_awarded\" INTEGER NOT NULL CHECK (\"module_xp_awarded\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "progress_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"progress_snapshots\" (\"id\" INTEGER NOT NULL, \"payload\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_installs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_installs\" (\"id\" INTEGER NOT NULL, \"installed_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
