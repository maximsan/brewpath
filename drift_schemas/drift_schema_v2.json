  "fixed_sql": [
    {
      "name": "progress_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"progress_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"lesson_id\" TEXT NOT NULL UNIQUE, \"is_completed\" INTEGER NOT NULL CHECK (\"is_completed\" IN (0, 1)), \"xp_earned\" INTEGER NOT NULL, \"completed_at\" INTEGER NOT NULL, \"full_xp_awarded\" INTEGER NOT NULL DEFAULT 1 CHECK (\"full_xp_awarded\" IN (0, 1)), \"best_score\" INTEGER NOT NULL DEFAULT 0, \"last_practice_xp_date\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "card_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"card_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"card_id\" TEXT NOT NULL UNIQUE, \"unlocked_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "user_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_settings\" (\"id\" INTEGER NOT NULL, \"haptics_enabled\" INTEGER NOT NULL CHECK (\"haptics_enabled\" IN (0, 1)), \"sound_enabled\" INTEGER NOT NULL CHECK (\"sound_enabled\" IN (0, 1)), \"total_xp\" INTEGER NOT NULL, \"streak_days\" INTEGER NOT NULL, \"last_activity_date\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "module_progress_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"module_progress_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"module_id\" TEXT NOT NULL UNIQUE, \"module_xp_awarded\" INTEGER NOT NULL CHECK (\"module_xp_awarded\" IN (0, 1)));"
        }
      ]
    }
