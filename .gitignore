# Isar native binary — copied from pub cache for `flutter test` on macOS.
# Reproduce with: cp ~/.pub-cache/hosted/pub.dev/isar_flutter_libs-3.1.0+1/macos/libisar.dylib libisar.dylib
libisar.dylib

