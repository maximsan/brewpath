#!/bin/sh
# The CI gates that need no device, before the push: format, analyze, metrics,
# the guard tests and the changelog check. About a minute. Skip with
# `git push --no-verify`; skip only the changelog check with NO_CHANGELOG=1.
set -eu

# Git feeds one line per ref on stdin: local ref, local sha, remote ref, remote
# sha. Read it before forwarding, so a global hook that reads stdin too gets it.
HOOK_STDIN=$(cat)
. "$(dirname "$0")/run_global_hook.sh"

# An all-zero local sha is a branch deletion; nothing to check for those.
pushing=$(printf '%s\n' "$HOOK_STDIN" \
  | grep -c -v -e '^$' -e ' 0000000000000000000000000000000000000000 ' || true)
[ "$pushing" -gt 0 ] || exit 0

cd "$(git rev-parse --show-toplevel)"
# Git hands hooks GIT_DIR; the Flutter wrappers shell out to git for the SDK's
# own version and would read this repository instead.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

dart format --output=none --set-exit-if-changed lib test integration_test
flutter analyze
dart run dart_code_linter:metrics analyze lib --set-exit-on-violation-level=warning
find test -name '*_guard_test.dart' -print0 | xargs -0 flutter test

# The changelog job runs on pull requests; main has already been through it.
if [ "${NO_CHANGELOG:-0}" != 1 ] && [ "$(git rev-parse --abbrev-ref HEAD)" != main ]; then
  tool/check_changelog.sh
fi
